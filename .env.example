# Шаблон переменных окружения. Скопируйте в .env и заполните: `cp .env.example .env`.
# .env в git НЕ коммитится (см. .gitignore) — там могут лежать ключи.
#
# Кто читает этот файл:
#   * docker compose — автоматически подставляет значения в docker-compose.yml;
#   * локальный запуск — сам Python .env не читает; загрузите переменные в shell:
#       set -a && . ./.env && set +a
# Пустое значение = «не задано»: тогда действует значение из YAML-конфига.

# --- Сервис -----------------------------------------------------------------
# Какой конфиг загружает API (offline — без нейросетей, default — e5 + реранкер).
KBRAG_CONFIG=configs/offline.yaml
# Каталог с документами базы знаний (пусто → corpus_dir из конфига).
# Только для локального запуска: в Docker корпус «запечён» в образ (/app/data/corpus),
# docker-compose.yml эту переменную не передаёт; другой корпус в контейнере — через монтирование тома.
KBRAG_CORPUS_DIR=
# Допустимые значения заголовка Host через запятую (пусто → localhost, 127.0.0.1, [::1], app).
# Нужно, если сервис открывают по IP или имени в сети: KBRAG_ALLOWED_HOSTS=192.168.1.10,kb.local
KBRAG_ALLOWED_HOSTS=
# Уровень логов kbrag (DEBUG, INFO, WARNING); пусто → INFO.
KBRAG_LOG_LEVEL=

# --- Генерация ответа -------------------------------------------------------
# extractive — без LLM (из конфига по умолчанию); openai — любой OpenAI-совместимый API.
KBRAG_GENERATION_BACKEND=
# Адрес API: vLLM локально — http://localhost:8000/v1; в docker compose — http://llm:8000/v1 (по умолчанию).
KBRAG_LLM_BASE_URL=
# Имя модели, как его знает сервер LLM (vLLM в compose загружает эту же модель).
KBRAG_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Лимиты запроса к LLM; пусто — из конфига (60 с, 512 токенов). Для медленной локальной модели,
# например scripts/serve_local_llm.py с 4-битной моделью на слабой видеокарте: 180 и 256.
KBRAG_LLM_TIMEOUT_S=
KBRAG_LLM_MAX_TOKENS=
# Ключ API. Пусто — для локального vLLM без авторизации. Никогда не пишите ключ в YAML-конфиги.
LLM_API_KEY=

# --- Модели Hugging Face ----------------------------------------------------
# Куда скачивать модели (e5, реранкер). Внутри Docker путь задаётся в docker-compose.yml.
HF_HOME=.cache/huggingface
# Токен нужен только для закрытых (gated) моделей; Qwen2.5, e5 и bge открыты.
HF_TOKEN=

# --- Docker -----------------------------------------------------------------
# true → образ с sentence-transformers и torch (нужен для configs/default.yaml).
INSTALL_NEURAL=false
# Версия образа vLLM для профиля llm.
VLLM_VERSION=v0.8.5

# --- Тесты ------------------------------------------------------------------
# 1 → запускать тесты с маркером neural (скачают модели при первом прогоне).
KBRAG_RUN_NEURAL=0
