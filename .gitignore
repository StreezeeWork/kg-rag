# Виртуальные окружения (.venv — проект, .venv-llm — отдельный GPU-сервер LLM)
.venv/
.venv-*/
venv/

# Python: байт-код и артефакты сборки пакета
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Кэши инструментов
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Кэш эмбеддингов и скачанных моделей — пересоздаётся автоматически
.cache/

# Отчёты генерируются командами `make eval` / `make grid` и в git не попадают (это черновики прогонов).
# Исключение — калибровка порога отказа: её читает сервис (abstention.threshold: auto), поэтому
# свежий клон и Docker-образ получают её из git. Что порог не устарел, проверяет CI
# (scripts/check_calibration.py); обновляется он командой `make eval`.
reports/*
!reports/.gitkeep
!reports/calibration*.json
# Модель классификатора отказа (abstention.method: classifier) сервис тоже читает из reports/ —
# по той же причине она в git: JSON-метаданные (+ веса logreg) и деревья CatBoost (.cbm).
!reports/abstention*.json
!reports/abstention*.cbm

# Секреты и локальные настройки: .env и любые варианты (.env.local, .env.prod, …).
# Шаблон .env.example без секретов — в git.
.env
.env.*
!.env.example

# Редакторы и ОС
.idea/
.vscode/
.DS_Store
Thumbs.db
