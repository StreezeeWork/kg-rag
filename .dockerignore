# Что НЕ отправляется в контекст сборки Docker.
# Меньше контекст — быстрее `docker build` и меньше шанс случайно запечь в образ лишнее (секреты, кэши).

# Git и CI
.git
.github

# Виртуальные окружения и кэши Python/инструментов
.venv
venv
**/__pycache__
**/*.py[cod]
**/*.egg-info
.pytest_cache
.ruff_cache
.mypy_cache
.cache

# Секреты: .env и его варианты (.env.local, .env.prod, …) никогда не должны попадать в образ.
# Шаблон .env.example сервису тоже не нужен, так что исключаем всё семейство.
.env
.env.*

# Эталонный набор нужен только для оценки (`kbrag eval`), сервис читает лишь корпус data/corpus
data/eval

# Отчёты оценки не нужны сервису — кроме файлов калибровки порога отказа и модели отказа
reports/*
!reports/.gitkeep
!reports/calibration*.json
!reports/abstention*.json
!reports/abstention*.cbm

# Не нужно во время работы сервиса
tests
docs
scripts
Dockerfile
docker-compose.yml
Makefile

# Файлы редакторов и ОС
.idea
.vscode
**/.DS_Store
**/Thumbs.db
